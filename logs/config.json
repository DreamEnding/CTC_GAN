{
  "device": "cpu",
  "model": {
    "disc_features": 64,
    "gen_features": 64,
    "image_size": 64,
    "in_channels": 3,
    "latent_dim": 512,
    "out_channels": 3,
    "residual_blocks": 9,
    "use_attention": true,
    "use_noise_injection": true
  },
  "paths": {
    "checkpoint_dir": "./checkpoints",
    "data_dir": "/tmp/test_data",
    "log_dir": "./logs",
    "output_dir": "/tmp/test_output"
  },
  "training": {
    "batch_size": 4,
    "beta1": 0.5,
    "beta2": 0.999,
    "lambda_cycle": 0.0,
    "lambda_gp": 10.0,
    "lambda_identity": 0.0,
    "lambda_perceptual": 1.0,
    "learning_rate": 0.0002,
    "num_epochs": 100,
    "save_every": 10,
    "validate_every": 5
  }
}